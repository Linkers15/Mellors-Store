endicon

on start
  game.create(128, 128, "#0F172A")
  game.start(5, "gameFrame")
end
on gameFrame
  game.clear("#0F172A")
  game.text("SENSOR DESK", 15, 4)
  game.text("Roll: " + math.floor(device.roll()), 2, 25)
  game.text("Pitch: " + math.floor(device.pitch()), 2, 42)
  game.text("Light: " + device.light(), 2, 59)
  game.text("A: " + device.buttonA(), 2, 76)
  game.text("B exits", 2, 105)
  game.draw(false)
end
on pause
  game.stop()
end
on back
  game.stop()
end
on resume
  game.start(5, "gameFrame")
end
