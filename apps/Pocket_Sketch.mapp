endicon

on start
  let x = 64
  let y = 64
  game.create(128, 128, "#000000")
  game.clear("#000000")
  game.text("Stick: draw A:clear", 0, 0)
  game.start(20, "gameFrame")
end
on gameFrame
  let ox = x
  let oy = y
  if game.keyDown("A")
    game.clear("#000000")
  end
  if game.keyDown("ArrowLeft")
    set x = x - 2
  end
  if game.keyDown("ArrowRight")
    set x = x + 2
  end
  if game.keyDown("ArrowUp")
    set y = y - 2
  end
  if game.keyDown("ArrowDown")
    set y = y + 2
  end
  set x = math.max(0, math.min(127, x))
  set y = math.max(12, math.min(127, y))
  game.line(ox, oy, x, y, "#38BDF8")
  game.draw(false)
end

on pause
  game.stop()
end
on back
  game.stop()
end
on resume
  game.start(20, "gameFrame")
end
