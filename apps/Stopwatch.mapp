endicon

on start
  let elapsed = 0
  let running = 0
  let last = system.now()
  let held = 0
  game.create(128, 128, "#0F172A")
  game.start(20, "gameFrame")
end
on gameFrame
  let now = system.now()
  if running == 1
    set elapsed = elapsed + now - last
  end
  set last = now
  if game.keyDown("A") && held == 0
    set running = 1 - running
  end
  set held = game.keyDown("A")
  if game.keyDown("ArrowDown") && running == 0
    set elapsed = 0
  end
  game.clear("#0F172A")
  game.text("STOPWATCH", 20, 10)
  game.text(math.floor(elapsed / 100) / 10 + " s", 14, 40)
  game.text("A: start / pause", 2, 75)
  game.text("Down: reset paused", 2, 90)
  game.text("B: exit", 2, 105)
  game.draw(false)
end
on pause
  set running = 0
  game.stop()
end
on back
  game.stop()
end
on resume
  set last = system.now()
  game.start(20, "gameFrame")
end
